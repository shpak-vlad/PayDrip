# Deployment Configuration
PRIVATE_KEY=0x...
BASESCAN_API_KEY=...

# Network
NETWORK=base-mainnet

# PayDrip Contract
PAYDRIP_PROXY=0x6f2bd18433b0aea1a10be7af88d3a6bbdd0f8b1e

